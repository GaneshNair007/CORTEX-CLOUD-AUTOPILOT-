{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx console-server.ts",
    "build": "vite build && esbuild console-server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "build:static": "vite build --outDir dist-static",
    "test:e2e": "npm run build && playwright test",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist server.js",
    "lint": "tsc --noEmit",
    "lint:console": "tsc --noEmit -p tsconfig.console.json",
    "test": "npx tsx tests/run_tests.ts"
  },
  "dependencies": {
    "@flowstack-ui/brick": "0.2.2",
    "@fontsource-variable/inter-tight": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@google/genai": "^2.4.0",
    "@gsap/react": "^2.1.2",
    "@radix-ui/react-dialog": "1.1.15",
    "@radix-ui/react-slot": "1.2.3",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "framer-motion": "^13.1.1",
    "gsap": "^3.15.0",
    "lenis": "^1.3.26",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "ogl": "^1.0.11",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tailwind-merge": "3.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/express": "^4.17.25",
    "@types/node": "^22.14.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "prettier": "3.9.7",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.9",
    "typescript": "~5.8.2",
    "vite": "^6.4.3"
  }
}
