# ─────────────────────────────────────────────────────────────────────────────
# CORTEX Frontend Environment Variables
# Copy to .env for local dev. Set as Vercel environment variables in production.
# ─────────────────────────────────────────────────────────────────────────────

# VITE_API_URL — Public HTTPS URL of your deployed FastAPI backend.
# ⚠ Required in production (Vercel static build). Leave blank for local dev
#   (the Express proxy handles /api/* routing to PYTHON_BACKEND_URL instead).
# Use the actual backend URL after deployment, not an assumed service hostname.
# Never put inference-provider API keys or CORTEX role tokens in VITE_* variables.
VITE_API_URL=

# PYTHON_BACKEND_URL — Only used by the local Express dev proxy (console-server.ts).
# Set this to your backend address when developing locally.
PYTHON_BACKEND_URL=http://127.0.0.1:8000

# PORT — Port for the local Express + Vite dev server.
PORT=3100
