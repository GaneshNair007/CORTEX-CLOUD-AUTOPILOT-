# CORTEX LLM provider configuration
# Copy this file to backend/.env (or configure equivalent deployment secrets).
# NEVER commit real API keys.

# -----------------------------------------------------------------------------
# Option A: CheaperInference (OpenAI-compatible API)
# -----------------------------------------------------------------------------
# Recommended when you want to route CORTEX through CheaperInference.
LLM_MODE=openai
OPENAI_API_KEY=ci_live_REPLACE_WITH_YOUR_NEW_REVOKED_AND_ROTATED_KEY
OPENAI_BASE_URL=https://api.cheaperinference.com/v1
OPENAI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Option B: Direct Google Gemini
# -----------------------------------------------------------------------------
# To use direct Gemini instead, set LLM_MODE=gemini and provide a genuine
# Google AI Studio API key. Do not use a CheaperInference ci_live_* key here.
# LLM_MODE=gemini
# GEMINI_API_KEY=REPLACE_WITH_GOOGLE_AI_STUDIO_KEY
# GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Optional local fallback
# -----------------------------------------------------------------------------
# LLM_MODE=ollama
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b

# APP_URL is the public URL where your own CORTEX application is hosted.
# It is NOT the LLM provider base URL.
# APP_URL=https://your-cortex-app.example.com
