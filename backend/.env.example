# Copy to backend/.env or run python -m backend.scripts.setup_local from repo root.
# Process environment wins. Do not commit .env or put provider keys in the frontend.
# Revoke previously exposed keys; configure only newly issued credentials here.

# NVIDIA is the primary external inference provider.
LLM_PRIMARY_PROVIDER=nvidia
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=nvidia/nemotron-3.5-lightning-30b-a3b

# Optional independent providers: configure only those you intend to use.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-haiku-latest
OLLAMA_HOST=http://127.0.0.1:11434
OLLAMA_MODEL=llama3.1:8b
CHEAPERINFERENCE_API_KEY=
CHEAPERINFERENCE_MODEL=gemini-2.0-flash
CHEAPERINFERENCE_BASE_URL=https://api.cheaperinference.com/v1

# Fallback is visibly DEGRADED and is not proof that external inference worked.
LLM_FALLBACK_PROVIDERS=heuristic
ALLOW_PAID_LLM_FALLBACK=false
CORTEX_LLM_TIMEOUT_SECONDS=30
CORTEX_LLM_MAX_RETRIES=2
CORTEX_LLM_MAX_OUTPUT_TOKENS=800
CORTEX_LLM_MAX_REQUESTS_PER_INCIDENT=4
# Optional numeric dollar cap; unknown provider cost must not be invented.
CORTEX_LLM_MAX_COST_PER_INCIDENT_USD=
CORTEX_ALLOWED_MODELS=

# Omit provider overrides to inherit the primary provider; model overrides are optional.
# DIAGNOSIS_PROVIDER=nvidia
# CRITIQUE_PROVIDER=nvidia
# SEMANTIC_REVIEW_PROVIDER=nvidia
DIAGNOSIS_MODEL=
CRITIQUE_MODEL=
ENABLE_SEMANTIC_REVIEW=false
ENABLE_ADAPTIVE_ROUTING=0

# Server-side API bearer tokens: distinct values, at least 32 characters each.
# setup_local generates missing values without printing them.
CORTEX_ADMIN_TOKEN=
CORTEX_OPERATOR_TOKEN=
CORTEX_VIEWER_TOKEN=
CORTEX_PUBLIC_READS=false
APP_URL=http://127.0.0.1:8000
CORTEX_CORS_ORIGINS=http://localhost:3100,http://127.0.0.1:3100,http://localhost:3000,http://127.0.0.1:3000

# Defaults use local files in backend/data and backend/rag/chroma_db.
# A persistent hosted volume must cover both directories when overriding them.
# CORTEX_DATA_DIR=/absolute/path/to/cortex-state
# CORTEX_CHROMA_DIR=/absolute/path/to/cortex-state/chroma
# CORTEX_DATABASE_URL=sqlite:////absolute/path/to/cortex-state/cortex_control_plane.db
# Set true only for a filesystem you have verified survives service recreation.
CORTEX_PERSISTENT_STORAGE=false

RETRIEVAL_TOP_K=5
RETRIEVAL_CANDIDATE_K=30
# Blank means no hard age cutoff; smooth decay still affects ranking.
RETRIEVAL_MAX_AGE_DAYS=
RETRIEVAL_RECENCY_HALF_LIFE=180
RETRIEVAL_RUNBOOK_HALF_LIFE=730
RETRIEVAL_HIGH_CONFIDENCE=0.82
RETRIEVAL_MIN_ACCEPTABLE=0.70
RETRIEVAL_CONFIDENT_COUNT=3
RETRIEVAL_MIN_SEMANTIC_RELEVANCE=0.28
RETRIEVAL_DIVERSITY_PENALTY=0.08

# Local demo: start eight controlled HTTP service threads on ports 8010-8017.
# These emulate services; they are not actual PostgreSQL/Redis/cloud infrastructure.
# Hosted default in render.yaml/Dockerfile is false.
CORTEX_START_SANDBOX=true
